{
  "name": "claude-deck",
  "version": "1.4.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "smoke": "set CT_SMOKE=1&& electron ."
  },
  "description": "Multi-session terminal manager for Claude Code",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "productName": "Claude Deck",
  "private": true,
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "author": "Aaron",
  "license": "MIT",
  "build": {
    "appId": "com.aaron.claudedeck",
    "productName": "Claude Deck",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "telegram.js",
      "src/**/*",
      "build/icon.png",
      "node_modules/**/*",
      "package.json",
      "!node_modules/**/{test,tests,docs,*.md,*.map}",
      "!dist/**"
    ],
    "asarUnpack": [
      "**/@lydell/**/*",
      "**/*.node",
      "**/*.exe",
      "**/*.dll"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Deck",
      "runAfterFinish": true
    },
    "afterPack": "build/afterPack.js"
  }
}